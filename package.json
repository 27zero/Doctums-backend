{
  "name": "sanity-doctums",
  "private": true,
  "version": "1.0.0",
  "description": "Sanity Studio para la migración de doctums.com",
  "main": "package.json",
  "keywords": [
    "sanity",
    "doctums"
  ],
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "typegen": "sanity schema extract && sanity typegen generate",
    "seed": "sanity dataset import seed/doctums-seed.ndjson --dataset production --replace",
    "webflow:build": "node scripts/webflow-import.mjs",
    "webflow:import": "sanity dataset import seed/webflow-import.ndjson --dataset production --replace",
    "migrate": "npm run seed && npm run webflow:build && npm run webflow:import"
  },
  "dependencies": {
    "@portabletext/block-tools": "^6.0.8",
    "@sanity/document-internationalization": "^6.3.1",
    "@sanity/icons": "^5.4.0",
    "@sanity/vision": "^6.25.0",
    "csv-parse": "^7.0.3",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanity": "^6.25.0",
    "sanity-plugin-internationalized-array": "^5.3.10",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
